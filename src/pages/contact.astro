---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact OSOOL — Book Your Luxury Consultation | تواصل مع أصول" page="contact">

  <!-- HERO -->
  <section class="relative min-h-[60vh] flex items-end overflow-hidden" style="padding-top:100px;">
    <div class="absolute inset-0" style="background:radial-gradient(ellipse 70% 50% at 50% 90%, rgba(201,169,110,.12) 0%, transparent 60%), linear-gradient(180deg,#080808 0%,#1a1208 55%,#080808 100%);"></div>
    <div class="absolute inset-0 flex items-center justify-end overflow-hidden pointer-events-none" aria-hidden="true">
      <span class="font-cormorant font-light" style="font-size:50vw; opacity:.03; line-height:.8; color:var(--gold); margin-right:-10vw;">C</span>
    </div>
    <div class="relative z-10 section-pad w-full max-w-screen-xl mx-auto pb-24">
      <div class="label-en mb-6 reveal" style="color:var(--gold);">Begin Your Journey</div>
      <h1 class="display-en mb-4 reveal reveal-delay-1">
        GET IN<br/><em style="font-style:italic; color:var(--gold);">TOUCH</em>
      </h1>
      <p class="display-ar reveal reveal-delay-2" style="font-size:clamp(1.8rem,3.5vw,4rem);">تواصل معنا</p>
    </div>
  </section>

  <!-- MAIN CONTACT SECTION -->
  <section class="section-pad" style="background:var(--black-deep);">
    <div class="max-w-screen-xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16">

      <!-- Left: Contact info + WhatsApp -->
      <div>
        <div class="label-en mb-6 reveal" style="color:var(--gold);">How to Reach Us</div>
        <h2 class="headline-en mb-4 reveal reveal-delay-1">Let's Start<br/>a Conversation</h2>
        <p class="font-amiri mb-8 reveal reveal-delay-2" style="color:var(--sandstone); font-size:1.5rem;" dir="rtl">لنبدأ حواراً</p>
        <p class="body-luxury max-w-md mb-10 reveal reveal-delay-3">
          Every extraordinary facade starts with a conversation. Tell us your vision — where you are,
          what you dream of, and what's currently standing in the way of architectural greatness.
          We'll take it from there.
        </p>

        <!-- Contact methods -->
        <div class="space-y-6 reveal reveal-delay-3">
          <!-- WhatsApp -->
          <a href="https://wa.me/966500000000" target="_blank" rel="noopener noreferrer"
            class="flex items-center gap-5 p-6 luxury-card bg-o-card group transition-all duration-300 hover:border-green-500">
            <div class="w-14 h-14 rounded-full flex items-center justify-center flex-shrink-0" style="background:#25D366;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <div class="label-en mb-1" style="color:#25D366;">WhatsApp (Fastest Response)</div>
              <div class="font-cormorant font-light text-xl" style="color:var(--ivory);">+966 50 000 0000</div>
              <div class="body-luxury text-xs mt-1">Available Saturday–Thursday, 9AM–9PM (KSA)</div>
            </div>
          </a>

          <!-- Email -->
          <a href="mailto:info@osoolstudio.com"
            class="flex items-center gap-5 p-6 luxury-card bg-o-card group">
            <div class="w-14 h-14 border flex items-center justify-center flex-shrink-0" style="border-color:var(--black-border); color:var(--gold);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <div class="label-en mb-1" style="color:var(--gold);">Email</div>
              <div class="font-cormorant font-light text-xl" style="color:var(--ivory);">info@osoolstudio.com</div>
              <div class="body-luxury text-xs mt-1">Response within 24 hours</div>
            </div>
          </a>

          <!-- Location -->
          <div class="flex items-center gap-5 p-6 luxury-card bg-o-card">
            <div class="w-14 h-14 border flex items-center justify-center flex-shrink-0" style="border-color:var(--black-border); color:var(--gold);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <div class="label-en mb-1" style="color:var(--gold);">Studio Location</div>
              <div class="font-cormorant font-light text-xl" style="color:var(--ivory);">Riyadh, Saudi Arabia</div>
              <div class="body-luxury text-xs mt-1">Site visits available across the Gulf region</div>
            </div>
          </div>
        </div>

        <!-- Quote box -->
        <div class="mt-10 p-8 border-l-2 reveal reveal-delay-4" style="border-color:var(--gold); background:rgba(201,169,110,.04);">
          <p class="font-cormorant italic text-lg" style="color:var(--ivory); line-height:1.5;">
            "We don't simply answer enquiries. We begin architectural relationships that last
            for the lifetime of the building."
          </p>
          <p class="font-amiri mt-3 text-sm" style="color:var(--bronze);" dir="rtl">
            "نحن لا نرد فقط على الاستفسارات. نبدأ علاقات معمارية تدوم طوال عمر المبنى."
          </p>
        </div>
      </div>

      <!-- Right: Consultation form -->
      <div>
        <div class="label-en mb-6 reveal" style="color:var(--gold);">Request a Consultation</div>
        <h3 class="font-cormorant font-light text-3xl mb-2 reveal reveal-delay-1" style="color:var(--ivory);">Tell Us About Your Project</h3>
        <p class="font-amiri mb-8 reveal reveal-delay-2" style="color:var(--bronze); font-size:1.1rem;" dir="rtl">أخبرنا عن مشروعك</p>

        <form id="consultation-form" class="space-y-5 reveal reveal-delay-2" novalidate>
          <!-- Name -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="form-group">
              <label class="label-en mb-2 block" style="color:var(--gold-muted);" for="first-name">First Name</label>
              <input
                type="text" id="first-name" name="first_name" required
                placeholder="Mohammed"
                class="luxury-input w-full"
              />
            </div>
            <div class="form-group">
              <label class="label-en mb-2 block" style="color:var(--gold-muted);" for="last-name">Last Name / Family</label>
              <input
                type="text" id="last-name" name="last_name" required
                placeholder="Al-Rashid"
                class="luxury-input w-full"
              />
            </div>
          </div>

          <!-- Contact -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="form-group">
              <label class="label-en mb-2 block" style="color:var(--gold-muted);" for="phone">WhatsApp / Phone</label>
              <input
                type="tel" id="phone" name="phone" required
                placeholder="+966 5x xxx xxxx"
                class="luxury-input w-full"
              />
            </div>
            <div class="form-group">
              <label class="label-en mb-2 block" style="color:var(--gold-muted);" for="email">Email Address</label>
              <input
                type="email" id="email" name="email"
                placeholder="your@email.com"
                class="luxury-input w-full"
              />
            </div>
          </div>

          <!-- Location -->
          <div class="form-group">
            <label class="label-en mb-2 block" style="color:var(--gold-muted);" for="location">Project Location / City</label>
            <input
              type="text" id="location" name="location"
              placeholder="Riyadh, Jeddah, Dubai..."
              class="luxury-input w-full"
            />
          </div>

          <!-- Service type -->
          <div class="form-group">
            <label class="label-en mb-2 block" style="color:var(--gold-muted);" for="service">Service Required</label>
            <select id="service" name="service" class="luxury-input w-full" style="appearance:none;">
              <option value="" disabled selected>Select a service...</option>
              <option>Luxury Facade Design</option>
              <option>GRC Decorative Systems</option>
              <option>Facade Transformation</option>
              <option>Palace Entrance Design</option>
              <option>Outdoor Luxury Structures</option>
              <option>AI Architectural Visualization</option>
              <option>Complete Estate Design</option>
              <option>General Consultation</option>
            </select>
          </div>

          <!-- Budget range -->
          <div class="form-group">
            <label class="label-en mb-2 block" style="color:var(--gold-muted);" for="budget">Approximate Budget Range</label>
            <select id="budget" name="budget" class="luxury-input w-full" style="appearance:none;">
              <option value="" disabled selected>Select budget range...</option>
              <option>Under SAR 200,000</option>
              <option>SAR 200,000 – 500,000</option>
              <option>SAR 500,000 – 1,000,000</option>
              <option>SAR 1,000,000 – 3,000,000</option>
              <option>Over SAR 3,000,000</option>
              <option>To be discussed</option>
            </select>
          </div>

          <!-- Message -->
          <div class="form-group">
            <label class="label-en mb-2 block" style="color:var(--gold-muted);" for="message">Describe Your Vision</label>
            <textarea
              id="message" name="message" rows="5"
              placeholder="Tell us about your property, your vision, what you love about classic architecture, what you want to achieve..."
              class="luxury-input w-full resize-none"
            ></textarea>
            <p class="font-amiri text-xs mt-1" style="color:var(--bronze);" dir="rtl">صفّ لنا رؤيتك وما تريد تحقيقه في واجهتك</p>
          </div>

          <!-- Preferred contact method -->
          <div class="form-group">
            <div class="label-en mb-3" style="color:var(--gold-muted);">Preferred Contact Method</div>
            <div class="flex flex-wrap gap-4">
              {['WhatsApp', 'Phone Call', 'Email'].map(method => (
                <label class="flex items-center gap-2 body-luxury text-sm cursor-none">
                  <input type="radio" name="contact_method" value={method} class="accent-gold" style="accent-color:var(--gold);" />
                  {method}
                </label>
              ))}
            </div>
          </div>

          <!-- Submit -->
          <button type="submit" id="submit-btn" class="btn-luxury w-full justify-center mt-4">
            <span id="submit-text">Send Consultation Request</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>

          <!-- Success state (hidden) -->
          <div id="form-success" class="hidden p-6 text-center border" style="border-color:var(--gold); background:rgba(201,169,110,.05);">
            <div class="text-gold text-3xl mb-3 font-cormorant">✓</div>
            <p class="font-cormorant font-light text-xl mb-2" style="color:var(--ivory);">Thank you for reaching out</p>
            <p class="body-luxury text-sm">Our team will contact you within 24 hours, inshallah.</p>
            <p class="font-amiri mt-2 text-sm" style="color:var(--bronze);" dir="rtl">سيتواصل معك فريقنا خلال 24 ساعة، بإذن الله</p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-pad" style="background:var(--black);">
    <div class="max-w-screen-xl mx-auto">
      <div class="text-center mb-16">
        <div class="label-en mb-4 reveal" style="color:var(--gold);">Common Questions</div>
        <h2 class="headline-en reveal reveal-delay-1">FAQ</h2>
        <p class="font-amiri mt-2 reveal reveal-delay-2" style="color:var(--sandstone); font-size:1.8rem;" dir="rtl">الأسئلة الشائعة</p>
      </div>

      <div class="max-w-3xl mx-auto space-y-3">
        {[
          { q:'How long does a typical facade project take?', a:'A complete facade design and installation project typically takes 8–16 weeks from contract signing to completion, depending on complexity. Facade transformation projects can be completed in 4–8 weeks.' },
          { q:'Do you work outside Saudi Arabia?', a:'Yes. OSOOL has completed projects in Saudi Arabia, UAE, Kuwait, Qatar, Bahrain, and Egypt. We manage logistics and installation across the entire Gulf region and North Africa.' },
          { q:'Can I see examples of GRC elements before committing?', a:'Absolutely. We maintain a physical sample library at our Riyadh studio, and we provide AI-rendered visualizations of all elements in context on your specific facade before any fabrication begins.' },
          { q:'What is the minimum project size you work with?', a:'We work on projects ranging from single entrance gate designs to complete estate transformations. Our minimum engagement starts from SAR 150,000 for design and specification services.' },
          { q:'Do you provide a warranty on GRC installation?', a:'Yes. All OSOOL GRC installations carry a 5-year structural warranty and a 10-year material warranty against colour fade and surface degradation under normal exterior conditions.' },
          { q:'How does the AI visualization process work?', a:'After an initial consultation, our team generates multiple facade concept variations using generative AI tools, refined by our master architects. You receive photorealistic renders and 360° walkthroughs before approving any direction for fabrication.' },
        ].map(({ q, a },i) => (
          <div class={`luxury-card bg-o-card overflow-hidden reveal reveal-delay-${Math.min((i%3)+1,3)}`}>
            <details class="group">
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                <span class="font-cormorant font-light text-lg pr-6 group-open:text-gold transition-colors duration-300" style="color:var(--ivory);">{q}</span>
                <div class="w-8 h-8 border flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-open:rotate-45" style="border-color:var(--black-border); color:var(--gold);">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                </div>
              </summary>
              <div class="px-6 pb-6 border-t" style="border-color:var(--black-border);">
                <p class="body-luxury text-sm leading-relaxed pt-4">{a}</p>
              </div>
            </details>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .luxury-input {
    width: 100%;
    background: var(--black-card);
    border: 1px solid var(--black-border);
    color: var(--ivory);
    padding: 0.875rem 1.25rem;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    outline: none;
    -webkit-appearance: none;
  }
  .luxury-input:focus {
    border-color: rgba(201, 169, 110, 0.5);
    box-shadow: 0 0 0 2px rgba(201, 169, 110, 0.08);
  }
  .luxury-input::placeholder { color: var(--gold-muted); opacity: 0.6; }
  select.luxury-input option { background: var(--black-card); }
</style>

<script>
  const form   = document.getElementById('consultation-form') as HTMLFormElement;
  const btn    = document.getElementById('submit-btn');
  const btnTxt = document.getElementById('submit-text');
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn || !btnTxt) return;

    btnTxt.textContent = 'Sending...';
    btn.setAttribute('disabled', 'true');

    // Simulate form submission (replace with real endpoint)
    await new Promise(resolve => setTimeout(resolve, 1500));

    form.style.display = 'none';
    if (success) success.classList.remove('hidden');
  });
</script>
