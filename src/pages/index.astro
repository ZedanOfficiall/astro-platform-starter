---
import Layout from '../layouts/Layout.astro';
---

<Layout title="OSOOL — Luxury Architectural Facades & GRC Solutions | أصول" page="home">

  <!-- ═══════════════════════════════════════ HERO ═══ -->
  <section id="hero" class="relative w-full min-h-screen flex flex-col justify-end overflow-hidden">

    <!-- Atmospheric background -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 65% 85%, rgba(201,169,110,.13) 0%, transparent 68%), radial-gradient(ellipse 50% 40% at 15% 95%, rgba(139,115,85,.08) 0%, transparent 60%), linear-gradient(180deg, #080808 0%, #0D0B06 55%, #080808 100%);"></div>

    <!-- Architectural facade SVG illustration -->
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true" style="opacity: 0.18;">
      <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" class="absolute inset-0 w-full h-full" fill="none">
        <rect x="100" y="180" width="1240" height="720" fill="url(#hFacade)" opacity="0.4"/>
        <rect x="100" y="145" width="1240" height="55" fill="rgba(201,169,110,0.5)"/>
        <rect x="100" y="135" width="1240" height="15" fill="rgba(232,213,163,0.4)"/>
        <path d="M100 145 L720 30 L1340 145" stroke="rgba(201,169,110,0.6)" stroke-width="2.5" fill="none"/>
        {[180,310,440,570,700,830,960,1090,1220].map((x:number) => (
          <g key={x}>
            <rect x={x} y="120" width="55" height="780" fill="url(#hCol)"/>
            <ellipse cx={x+27} cy="123" rx="38" ry="58" fill="rgba(232,213,163,0.45)"/>
            <rect x={x-8} y="113" width="71" height="16" fill="rgba(201,169,110,0.55)"/>
            <rect x={x+5} y="113" width="45" height="8" fill="rgba(232,213,163,0.3)"/>
          </g>
        ))}
        {[240,490,740,990].map((x:number) => (
          <g key={x}>
            <rect x={x} y="420" width="130" height="210" fill="rgba(201,169,110,0.15)" stroke="rgba(201,169,110,0.4)" stroke-width="1.5"/>
            <path d={`M${x} 420 Q${x+65} 345 ${x+130} 420`} fill="rgba(201,169,110,0.25)"/>
            <rect x={x+20} y="230" width="90" height="130" fill="rgba(201,169,110,0.12)" stroke="rgba(201,169,110,0.3)" stroke-width="1"/>
          </g>
        ))}
        <ellipse cx="720" cy="900" rx="600" ry="90" fill="rgba(201,169,110,0.1)"/>
        <defs>
          <linearGradient id="hFacade" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#C9A96E" stop-opacity="0.35"/>
            <stop offset="60%" stop-color="#8B7355" stop-opacity="0.15"/>
            <stop offset="100%" stop-color="#080808" stop-opacity="0"/>
          </linearGradient>
          <linearGradient id="hCol" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#0d0905"/>
            <stop offset="30%" stop-color="#E8D5A3" stop-opacity="0.55"/>
            <stop offset="70%" stop-color="#C9A96E" stop-opacity="0.4"/>
            <stop offset="100%" stop-color="#0d0905"/>
          </linearGradient>
        </defs>
      </svg>
    </div>

    <!-- Warm bottom glow -->
    <div class="absolute bottom-0 inset-x-0 h-2/3" style="background: radial-gradient(ellipse 90% 60% at 50% 100%, rgba(201,169,110,0.15) 0%, transparent 70%);"></div>

    <!-- Noise texture -->
    <div class="absolute inset-0 pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.75%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22 opacity=%220.04%22/%3E%3C/svg%3E'); opacity: 0.6;"></div>

    <!-- Vertical side text -->
    <div class="absolute left-8 top-1/2 -translate-y-1/2 hidden xl:flex flex-col items-center gap-4" aria-hidden="true">
      <div class="h-16 w-px" style="background: var(--gold); opacity: 0.35;"></div>
      <span style="writing-mode: vertical-rl; transform: rotate(180deg); letter-spacing: 0.32em; font-size: 0.58rem; font-family: 'Cormorant Garamond', serif; color: var(--gold-muted); text-transform: uppercase;">ARCHITECTURAL FACADES &amp; GRC SOLUTIONS</span>
      <div class="h-16 w-px" style="background: var(--gold); opacity: 0.35;"></div>
    </div>

    <!-- Hero content -->
    <div class="relative z-10 px-6 md:px-12 xl:px-20 pb-24 md:pb-32">
      <div class="label-en mb-6 md:mb-10 reveal reveal-delay-1" style="color: var(--gold);">
        ✦ &nbsp; Est. 2020 &nbsp;·&nbsp; Riyadh, Saudi Arabia &nbsp;·&nbsp; osoolstudio.com
      </div>

      <h1 class="display-en mb-3 reveal reveal-delay-2">
        WHERE <br/>
        <em style="font-style: italic; color: var(--gold);">ARCHITECTURE</em><br/>
        BECOMES LEGACY
      </h1>

      <p class="display-ar reveal reveal-delay-3 mb-10 md:mb-16" style="font-size: clamp(2rem,4.5vw,5rem);">
        حيث تتحوّل العمارة إلى إرث
      </p>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 reveal reveal-delay-4">
        <a href="/portfolio" class="btn-luxury">
          <span>Explore Our Work</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/contact" class="btn-luxury-outline"><span>Get Consultation</span></a>
        <div class="hidden md:flex items-center gap-3 ml-2">
          <div class="h-px w-10" style="background: var(--gold); opacity:0.5;"></div>
          <span class="font-amiri text-bronze text-sm" dir="rtl">احجز استشارتك</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 right-10 hidden md:flex flex-col items-center gap-3" aria-hidden="true">
      <span style="writing-mode: vertical-rl; font-family: 'Cormorant Garamond', serif; font-size: 0.58rem; letter-spacing: 0.4em; color: var(--gold-muted); text-transform: uppercase;">SCROLL</span>
      <div class="relative w-px h-20" style="background: var(--black-border);">
        <div class="absolute inset-0" style="background: var(--gold); animation: scrollLine 2s ease infinite;"></div>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="absolute bottom-0 left-0 right-0 border-t hidden lg:grid grid-cols-4" style="border-color: var(--black-border);">
      {[
        { num: '250+', label: 'Facade Projects', ar: 'مشروع واجهات' },
        { num: '12+',  label: 'Years of Excellence', ar: 'عام من التميز' },
        { num: '8',    label: 'Gulf Countries', ar: 'دول خليجية' },
        { num: '100%', label: 'Client Satisfaction', ar: 'رضا العملاء' },
      ].map(({ num, label, ar }) => (
        <div class="px-8 py-5 border-r last:border-r-0 flex items-center gap-5" style="border-color: var(--black-border);">
          <span class="font-cormorant text-3xl font-light" style="color: var(--gold);">{num}</span>
          <div>
            <div class="text-xs tracking-widest uppercase" style="color: var(--ivory); opacity: 0.65;">{label}</div>
            <div class="font-amiri text-xs mt-0.5" style="color: var(--bronze);" dir="rtl">{ar}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════ BRAND STATEMENT ═══ -->
  <section class="section-pad max-w-screen-xl mx-auto">
    <div class="max-w-4xl">
      <div class="label-en mb-8 reveal" style="color: var(--gold);">Our Philosophy</div>
      <h2 class="reveal reveal-delay-1" style="font-family:'Cormorant Garamond',serif; font-size:clamp(2rem,4vw,5rem); font-weight:300; line-height:1.05; letter-spacing:-0.02em; color:var(--ivory);">
        We don't design buildings.<br/>
        <em style="font-style:italic; color:var(--gold);">We craft architectural identities</em><br/>
        that transcend time.
      </h2>
      <div class="h-px my-8 reveal reveal-delay-2" style="background: var(--black-border);"></div>
      <p class="body-luxury max-w-2xl reveal reveal-delay-3">
        OSOOL merges centuries of Arabic architectural heritage with contemporary luxury design thinking.
        Each facade we create is a statement — a permanent mark of distinction that elevates the
        surrounding landscape and endures as a monument to craftsmanship.
      </p>
      <p class="font-amiri mt-4 leading-loose reveal reveal-delay-4" style="color:var(--bronze); font-size:1.1rem;" dir="rtl">
        أصول تمزج بين الإرث المعماري العربي العريق وأفكار التصميم الفاخر المعاصر. كل واجهة نصنعها تحكي قصة، وتترك بصمة لا تُمحى في المشهد المحيط.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════ SERVICES GRID ═══ -->
  <section class="section-pad" style="background: var(--black-deep);" id="services">
    <div class="max-w-screen-xl mx-auto">

      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <div class="label-en mb-4 reveal" style="color: var(--gold);">What We Create</div>
          <h2 class="headline-en reveal reveal-delay-1">Our Services</h2>
          <p class="font-amiri mt-2 reveal reveal-delay-2" style="color:var(--sandstone); font-size:1.8rem;" dir="rtl">خدماتنا</p>
        </div>
        <a href="/services" class="btn-luxury-outline self-start reveal reveal-delay-2"><span>View All Services</span></a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px" style="background: var(--black-border);">
        {[
          { num:'01', title:'Luxury Facade Design', ar:'تصميم الواجهات الفاخرة', desc:'Palace-grade exterior design fusing neoclassical grandeur with modern precision and Arabic luxury aesthetics.', icon:'🏛' },
          { num:'02', title:'GRC Decorative Systems', ar:'أنظمة GRC الزخرفية', desc:'Corinthian columns, ornate cornices, arches, balustrades — our GRC collection transforms any villa into a masterpiece.', icon:'⬡' },
          { num:'03', title:'Facade Transformations', ar:'تحويل الواجهات', desc:'Dramatic before-and-after renovations. We reimagine aging exteriors as iconic luxury architectural statements.', icon:'✦' },
          { num:'04', title:'Palace Entrance Design', ar:'تصميم مداخل القصور', desc:'Monumental gates, royal archways, and dramatic thresholds that command authority and awe from arrival.', icon:'◉' },
          { num:'05', title:'Outdoor Luxury Structures', ar:'المنشآت الخارجية الفاخرة', desc:'Pergolas, majlis concepts, and architectural pavilions extending the palace language into the landscape.', icon:'◈' },
          { num:'06', title:'AI Visualization', ar:'التصور بالذكاء الاصطناعي', desc:'Photorealistic AI renders let you experience your transformed facade before a single stone is laid.', icon:'◎' },
        ].map(({ num, title, ar, desc, icon }, i) => (
          <div class={`luxury-card bg-o-card p-8 md:p-10 relative overflow-hidden group reveal reveal-delay-${Math.min(i+1,6)}`}>
            <div class="number-accent">{num}</div>
            <div class="text-2xl mb-5 transition-opacity duration-300" style="color:var(--gold); opacity:0.6;">{icon}</div>
            <h3 class="font-cormorant text-xl font-light mb-1 transition-colors duration-300 group-hover:text-gold" style="color:var(--ivory);">{title}</h3>
            <p class="font-amiri text-xs mb-5" style="color:var(--bronze);" dir="rtl">{ar}</p>
            <div class="h-px mb-5 transition-colors duration-500 group-hover:bg-gold" style="background:var(--black-border);"></div>
            <p class="body-luxury text-sm leading-relaxed">{desc}</p>
            <div class="mt-5 flex items-center gap-2 text-xs tracking-widest uppercase opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="color:var(--gold);">
              <span>Learn More</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ FEATURED PROJECTS ═══ -->
  <section class="section-pad" id="portfolio">
    <div class="max-w-screen-xl mx-auto">

      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <div class="label-en mb-4 reveal" style="color:var(--gold);">Selected Works</div>
          <h2 class="headline-en reveal reveal-delay-1">Featured Projects</h2>
          <p class="font-amiri mt-2 reveal reveal-delay-2" style="color:var(--sandstone); font-size:1.8rem;" dir="rtl">أبرز أعمالنا</p>
        </div>
        <a href="/portfolio" class="btn-luxury-outline self-start reveal reveal-delay-2"><span>Full Portfolio</span></a>
      </div>

      <!-- Large hero project -->
      <div class="reveal reveal-delay-1 mb-4">
        <div class="img-zoom-wrap relative overflow-hidden group" style="height:clamp(340px,52vw,680px);">
          <div class="img-fill absolute inset-0 transition-transform duration-700" style="background:radial-gradient(ellipse 70% 55% at 60% 75%, rgba(201,169,110,.22) 0%, transparent 65%), linear-gradient(160deg,#0d0a06 0%,#1a1208 40%,#0a0705 100%);"></div>
          <!-- Architectural composition -->
          <svg class="absolute inset-0 w-full h-full opacity-45" viewBox="0 0 1200 680" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
            <rect x="180" y="90" width="840" height="590" fill="url(#p1v)" opacity="0.55"/>
            {[240,360,480,720,840,960].map((x:number)=>(
              <g key={x}>
                <rect x={x} y="68" width="48" height="610" fill="url(#p1c)"/>
                <ellipse cx={x+24} cy="72" rx="34" ry="52" fill="rgba(232,213,163,.45)"/>
                <rect x={x-7} y="62" width="62" height="14" fill="rgba(201,169,110,.55)"/>
              </g>
            ))}
            <rect x="165" y="52" width="870" height="44" fill="rgba(201,169,110,.48)"/>
            <rect x="160" y="42" width="880" height="14" fill="rgba(232,213,163,.35)"/>
            <path d="M165 52 L600 -18 L1035 52" stroke="rgba(201,169,110,.65)" stroke-width="2.5"/>
            {[295,555,815].map((x:number)=>(
              <g key={x}>
                <rect x={x} y="380" width="115" height="195" fill="rgba(201,169,110,.18)" stroke="rgba(201,169,110,.45)" stroke-width="1.5"/>
                <path d={`M${x} 380 Q${x+57} 316 ${x+115} 380`} fill="rgba(201,169,110,.28)"/>
                <rect x={x+15} y="210" width="85" height="125" fill="rgba(201,169,110,.12)" stroke="rgba(201,169,110,.32)" stroke-width="1"/>
              </g>
            ))}
            <ellipse cx="600" cy="680" rx="480" ry="75" fill="rgba(201,169,110,.12)"/>
            <defs>
              <linearGradient id="p1v" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#C9A96E" stop-opacity="0.3"/>
                <stop offset="60%" stop-color="#8B7355" stop-opacity="0.12"/>
                <stop offset="100%" stop-color="#1a1208" stop-opacity="0.8"/>
              </linearGradient>
              <linearGradient id="p1c" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#0a0805"/>
                <stop offset="35%" stop-color="#E8D5A3" stop-opacity="0.55"/>
                <stop offset="65%" stop-color="#C9A96E" stop-opacity="0.4"/>
                <stop offset="100%" stop-color="#0a0805"/>
              </linearGradient>
            </defs>
          </svg>
          <div class="absolute inset-0" style="background:linear-gradient(to top, var(--black) 0%, transparent 50%);"></div>
          <div class="absolute bottom-0 left-0 right-0 p-8 md:p-12">
            <div class="label-en mb-2" style="color:var(--gold);">Riyadh · 2024</div>
            <h3 class="font-cormorant font-light mb-2" style="font-size:clamp(2rem,4vw,4rem); color:var(--ivory);">Al-Wajd Palace Villa</h3>
            <p class="font-amiri" style="color:var(--sandstone); font-size:1.2rem;" dir="rtl">قصر الوجد — واجهة نيوكلاسيكية بنظام GRC الملكي</p>
            <div class="flex flex-wrap gap-2 mt-4">
              {['Neoclassical','GRC Facade','Palace Grade'].map(t=>(
                <span class="label-en px-3 py-1 border" style="border-color:var(--black-border); color:var(--gold-muted);">{t}</span>
              ))}
            </div>
          </div>
          <a href="/portfolio" class="absolute top-6 right-6 w-12 h-12 flex items-center justify-center border opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background:var(--black-card); border-color:var(--black-border); color:var(--gold);" aria-label="View project">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
          </a>
        </div>
      </div>

      <!-- Three smaller projects -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {[
          { title:'Al-Noor Residences', ar:'مجمع النور', loc:'Jeddah · 2024', tags:['Transformation','GRC'], bg:'linear-gradient(135deg,#1a0f06,#2a1908,#0d0705)' },
          { title:'Khalij Palace',      ar:'قصر الخليج',  loc:'Kuwait · 2023',  tags:['Palace Entrance','Full Facade'], bg:'linear-gradient(135deg,#0a0d1a,#081220,#080808)' },
          { title:'Desert Retreat',     ar:'واحة الصحراء', loc:'Dubai · 2023',   tags:['Outdoor','Luxury'], bg:'linear-gradient(135deg,#120808,#1a0a06,#080808)' },
        ].map(({ title, ar, loc, tags, bg },i) => (
          <a href="/portfolio" class={`img-zoom-wrap relative overflow-hidden block reveal reveal-delay-${i+2}`} style={`height:clamp(220px,28vw,360px);`}>
            <div class="img-fill absolute inset-0 transition-transform duration-700" style={`background:${bg};`}></div>
            <svg class="absolute inset-0 w-full h-full opacity-35" viewBox="0 0 400 360" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
              <rect x="35" y="50" width="330" height="310" fill="url(#smGrad)"/>
              {[75,195,315].map((x:number)=>(
                <g key={x}><rect x={x} y="35" width="32" height="325" fill="rgba(201,169,110,.42)"/><ellipse cx={x+16} cy="38" rx="26" ry="42" fill="rgba(232,213,163,.4)"/></g>
              ))}
              <rect x="28" y="38" width="344" height="18" fill="rgba(201,169,110,.48)"/>
              <ellipse cx="200" cy="360" rx="190" ry="45" fill="rgba(201,169,110,.1)"/>
              <defs><linearGradient id="smGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#C9A96E" stop-opacity="0.22"/><stop offset="100%" stop-color="#080808" stop-opacity="0.85"/></linearGradient></defs>
            </svg>
            <div class="absolute inset-0" style="background:linear-gradient(to top, var(--black) 0%, transparent 55%);"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <div class="label-en mb-1" style="color:var(--gold-muted); font-size:.58rem;">{loc}</div>
              <h3 class="font-cormorant font-light" style="font-size:1.6rem; color:var(--ivory);">{title}</h3>
              <p class="font-amiri text-sm mt-0.5" style="color:var(--bronze);" dir="rtl">{ar}</p>
              <div class="flex flex-wrap gap-2 mt-3">
                {tags.map(t=><span class="label-en px-2 py-0.5 border" style="border-color:var(--black-border); color:var(--gold-muted); font-size:.55rem;">{t}</span>)}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════ BEFORE/AFTER ═══ -->
  <section class="section-pad" style="background:var(--black-warm);" id="transformations">
    <div class="max-w-screen-xl mx-auto">
      <div class="text-center mb-16">
        <div class="label-en mb-4 reveal" style="color:var(--gold);">The OSOOL Effect</div>
        <h2 class="headline-en mb-3 reveal reveal-delay-1">Facade Transformations</h2>
        <p class="font-amiri reveal reveal-delay-2" style="color:var(--sandstone); font-size:1.8rem;" dir="rtl">تحويل الواجهات — قبل وبعد</p>
        <p class="body-luxury max-w-lg mx-auto mt-4 reveal reveal-delay-3">Drag the slider to witness a complete architectural transformation.</p>
      </div>

      <div class="reveal reveal-delay-2">
        <div id="ba-slider" class="relative select-none overflow-hidden" style="height:clamp(280px,45vw,580px); cursor:ew-resize;">
          <!-- BEFORE panel -->
          <div class="absolute inset-0" style="background:linear-gradient(160deg,#1a1208,#2a1e10,#0d0905);">
            <svg class="w-full h-full opacity-35" viewBox="0 0 1200 580" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
              <rect x="80" y="80" width="1040" height="500" fill="rgba(160,140,100,.25)" stroke="rgba(100,80,40,.35)" stroke-width="2"/>
              {[150,380,610,840,1020].map((x:number)=>(
                <rect key={x} x={x} y="180" width="150" height="280" fill="rgba(130,110,70,.18)" stroke="rgba(90,70,30,.28)" stroke-width="1.5"/>
              ))}
              <rect x="80" y="80" width="1040" height="25" fill="rgba(110,90,50,.3)"/>
            </svg>
            <div class="absolute bottom-4 left-4 px-3 py-1 label-en" style="background:rgba(8,8,8,.85); color:var(--bronze);">BEFORE</div>
          </div>

          <!-- AFTER panel -->
          <div id="ba-after-panel" class="absolute inset-0" style="background:radial-gradient(ellipse 70% 60% at 50% 80%, rgba(201,169,110,.18) 0%, transparent 65%), linear-gradient(160deg,#0d0a06,#1a1208,#0a0805); clip-path:inset(0 50% 0 0);">
            <svg class="w-full h-full opacity-5" viewBox="0 0 1200 580" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
              <rect x="60" y="60" width="1080" height="520" fill="url(#baV)" opacity="0.6"/>
              {[120,250,380,820,950,1080].map((x:number)=>(
                <g key={x}>
                  <rect x={x} y="45" width="48" height="535" fill="url(#baC)"/>
                  <ellipse cx={x+24} cy="50" rx="36" ry="55" fill="rgba(232,213,163,.48)"/>
                  <rect x={x-7} y="40" width="62" height="14" fill="rgba(201,169,110,.58)"/>
                </g>
              ))}
              <rect x="50" y="30" width="1100" height="42" fill="rgba(201,169,110,.5)"/>
